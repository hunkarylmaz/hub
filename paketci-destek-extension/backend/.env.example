# ════════════════════════════════════════════════════════════════════
# GÜVENLİK: Bu dosya .env.example'dır — gerçek şifre İÇERMEZ.
# Gerçek değerleri kendi .env dosyanıza yazın; .env ASLA git'e eklenmez
# (.gitignore içinde tanımlıdır). Production'da bu değerler secret
# manager / environment variable olarak enjekte edilmelidir.
# ════════════════════════════════════════════════════════════════════

APP_NAME=Paketçi Destek Sistemi
BACKEND_PORT=3001
APP_BASE_URL=https://destek.sizin-domaininiz.com
ADMIN_PANEL_URL=https://destek.sizin-domaininiz.com/admin

# NODE_ENV=development | production — Helmet/CORS/log seviyesini etkiler.
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/paketci_support

REDIS_HOST=localhost
REDIS_PORT=6379

# CORS: yalnızca eklentinin "chrome-extension://<EXTENSION_ID>" origin'i
# ve (varsa) admin panel origin'i, virgülle ayrılmış liste.
CORS_ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID

# ── Google SMTP (Nodemailer) ──────────────────────────────────────────
# GÜVENLİK: GOOGLE_SMTP_PASSWORD normal Google hesap şifresi DEĞİL, Google
# Hesabı > Güvenlik > Uygulama Şifreleri üzerinden üretilen 16 haneli
# "App Password" olmalıdır (2FA açık olmalı). Bu değer SADECE bu backend
# .env dosyasında yaşar; Chrome eklentisine ASLA yazılmaz, hiçbir API
# response'unda dönmez, log'a yazılmaz.
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_SECURE=false
GOOGLE_SMTP_USER=destek@sizin-domaininiz.com
GOOGLE_SMTP_PASSWORD=buraya_google_app_password_yazilacak

MAIL_FROM_NAME=Paketçi Destek Sistemi
MAIL_FROM_EMAIL=destek@sizin-domaininiz.com
MAIL_REPLY_TO=destek@sizin-domaininiz.com

ADMIN_NOTIFICATION_EMAILS=operasyon@sizin-domaininiz.com,destek@sizin-domaininiz.com
CRITICAL_TICKET_EMAILS=yonetici@sizin-domaininiz.com
DAILY_REPORT_EMAILS=rapor@sizin-domaininiz.com

JWT_SECRET=change_this_secret
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=20

# Aynı e-postadan saatte en fazla N talep (servis seviyesi ek limit).
SUPPORT_REQUEST_PER_EMAIL_HOURLY_LIMIT=5

# GÜVENLİK: /api/admin/* ve /api/mail/test endpoint'lerini korumak için
# basit paylaşılan-sır header kontrolü (v1 — henüz tam admin/JWT auth yok).
# İstek header'ı: X-Admin-Api-Key: <ADMIN_API_KEY>
# v2'de gerçek admin login/JWT sistemine geçilince bu değişken kaldırılır.
ADMIN_API_KEY=change_this_admin_api_key

# Dosya yükleme limiti (byte) — extension/config.js ile AYNI olmalı.
MAX_ATTACHMENT_SIZE_BYTES=5242880
